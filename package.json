{
  "name": "oc-template",
  "version": "0.2.0",
  "description": "Ship your own OpenCode tool by copying a working plugin and dependency-free MCP server.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mcp",
    "template",
    "plugin",
    "server"
  ],
  "license": "MIT",
  "author": "nathwn12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathwn12/oc-templates.git"
  },
  "bugs": {
    "url": "https://github.com/nathwn12/oc-templates/issues"
  },
  "homepage": "https://github.com/nathwn12/oc-templates#readme",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "bin": {
    "oc-template-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node dist/mcp.js",
    "check": "npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
