{
  "name": "oc-template",
  "version": "0.1.0",
  "description": "Scaffold for an OpenCode v2 plugin plus a dependency-free stdio MCP server.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mcp",
    "template"
  ],
  "license": "MIT",
  "author": "nathwn12",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test test/*.test.mjs",
    "mcp": "node dist/mcp.js",
    "check": "npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
